{
  "name": "dsh-plugin-git-commit-push",
  "version": "1.0.5",
  "description": "0 Token Git 提交推送插件，一次调用完成，按 Conventional Commits 为每个变更文件自动生成提交信息并按 type(scope) 拆成多次提交后一次推送到Git，必要时询问打标签。One-call Conventional-Commits git workflow for DeepSeek Harness: survey + one commit per type(scope) + optional tag + push, plus a /git-commit-push slash command that runs with no model involvement. Windows and macOS/Linux.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*",
    "./git-commit-push.config.json": "./git-commit-push.config.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "icon": "./icon.svg",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.0-rc.1 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node self-test.mjs && node self-test-git.mjs",
    "probe": "node capture-git-format.mjs",
    "prepublishOnly": "node self-test.mjs && node self-test-git.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-git",
    "dsh-git-commit",
    "dsh-git-push"
  ],
  "author": "ygzhang <ygzhang.cn@msn.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ygzhang-lab/dsh-plugin-git-commit-push.git"
  },
  "homepage": "https://github.com/ygzhang-lab/dsh-plugin-git-commit-push#readme",
  "bugs": {
    "url": "https://github.com/ygzhang-lab/dsh-plugin-git-commit-push/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "git-commit-push.config.json",
    "setup.ps1",
    "setup.sh",
    "self-test.mjs",
    "self-test-git.mjs",
    "capture-git-format.mjs",
    "e2e-check.mjs",
    "SKILL.md",
    "AGENTS.md",
    "README.md",
    "README.en.md"
  ]
}
